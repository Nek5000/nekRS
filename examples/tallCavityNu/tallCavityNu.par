[GENERAL]
polynomialOrder = 6
stopAt = endTime
endTime = 2000

dt = targetCFL=2.0 + max=0.5 + initial=0.01
timeStepper = tombo2
advectionSubCyclingSteps = 2

checkpointControl = simulationTime
checkpointInterval = 200

regularization = hpfrt + nModes=1 + scalingCoeff=15

scalars = TEMPERATURE

[FLUID PRESSURE]
residualTol = 1e-04

[FLUID VELOCITY]
# raw boundary IDs (see tallCavityNu.box): 1=hot, 2=cold, 3=top,
# 4=bottom -- all four no-slip. 5=front/back, symmetry plane (this is
# a thin-slab stand-in for the paper's quasi-2D domain, not a real
# wall).
boundaryTypeMap = zeroDirichlet, zeroDirichlet, zeroDirichlet, zeroDirichlet, symy
rho = 1.0
viscosity = 1e-5
residualTol = 1e-06

[SCALAR TEMPERATURE]
# 1=hot: applied flux fh=0.5 W/m^2 MINUS net radiative loss (real
# radiative-convective coupling via Radiation::step()'s o_usrwrk,
# see tallCavityNu.udf). 2=cold: fixed T=100K. 3,4=top/bottom:
# "adiabatic" (zero APPLIED flux) but still radiatively active --
# a floating reradiating surface, same udfNeumann mechanism as the
# hot wall with appliedFlux=0. 5=front/back: plain zero-flux
# (insulated symmetry plane, no radiative coupling).
boundaryTypeMap = udfNeumann, udfDirichlet, udfNeumann, udfNeumann, zeroNeumann
diffusionCoeff = 0.01
transportCoeff = 1000
residualTol = 1e-06

[RADIATION]
# Box interior is convex (no obstructionBoundaryIDs needed). 
# Emissivity=1 for the 4 real walls -- reproducing the epsilon=1 case 
# from Fig. 6 first (per user direction: validate the coupling 
# mechanism at one emissivity before attempting the full Fig. 5 sweep).
#
# bID 5 (front/back symmetry planes) MUST be included here too, with
# emissivity 0. First attempt omitted it entirely, which is wrong: the
# Monte Carlo ray tracer has no notion of "symmetry" -- rays leaving
# any patch and heading toward an excluded boundary just vanish from
# the accounting instead of returning energy to the enclosure. With
# bID=5 excluded, view-factor row sums came out near 0 instead of ~1
# (confirmed empirically: at t=0, uniform T=100K everywhere, every
# group reported q~4.3-4.9 W/m^2 instead of ~0, i.e. nearly the full
# sigma*T^4=5.67 -- almost all "emitted" energy was being lost to the
# untracked front/back faces, which are actually the LARGEST surfaces
# in this thin-slab box: 20 m^2 each vs 5 m^2 for hot/cold, 0.25 m^2
# for top/bottom). Fix, matching the paper's own treatment of
# artificial/non-physical boundaries in Sec 4.4 (inlet/outlet set to
# emissivity=0, "a perfectly reflecting (mirror) boundary condition"):
# include bID=5 geometrically (so the view-factor math closes
# correctly) but with emissivity=0, so it neither absorbs nor emits
# net energy (q=0 there always, since q_i=eps_i*(...)=0) and doesn't
# distort the energy balance among the 4 real walls.
radiatingBoundaryIDs = 1,2,3,4,5
nSamples = 8192
seed = 1234
writeMatrix = true
cache = true
emissivity = 1.0,1.0,1.0,1.0,0.0
updateFrequency = 20
